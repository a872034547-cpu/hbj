# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and local package installs
.venv/
venv/
env/
ENV/

# Build / packaging outputs
build/
dist/
*.egg-info/
.eggs/

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
.DS_Store
Thumbs.db

# Frontend dependency/build outputs
node_modules/
.next/
.vite/
coverage/

# Local generated/runtime indexes and reports that can be rebuilt
libriscribe/chroma_db/
libriscribe/.pytest_cache/

# ToCodex local execution state (not product code)
.tocodex/progress/

# IMPORTANT:
# Do NOT ignore application configuration, prompt, project, or key files here.
# The user wants config/secrets changes to sync via GitHub/server pull.
# Therefore .env, *.env, config/, prompts/, projects/, *.key, *.pem are intentionally NOT ignored.
